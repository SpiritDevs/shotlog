{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UUID": {
      "type": "string",
      "description": "a Universally Unique Identifier",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "NonNegativeInt": {
      "type": "integer",
      "description": "an integer",
      "title": "int",
      "minimum": 0
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/JsonNumber"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "JsonNumber": {
      "type": "number",
      "description": "a finite number",
      "title": "finite"
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "shortId",
    "createdAt",
    "type",
    "description",
    "environment"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "id": {
      "$ref": "#/$defs/UUID"
    },
    "shortId": {
      "type": "string",
      "description": "a string matching the pattern ^SL-[0-9A-HJKMNP-TV-Z]{4}$",
      "pattern": "^SL-[0-9A-HJKMNP-TV-Z]{4}$"
    },
    "createdAt": {
      "type": "string",
      "description": "a string matching the pattern ^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "a string at most 40 character(s) long",
      "title": "maxLength(40)",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "description": "a string at most 10000 character(s) long",
      "title": "maxLength(10000)",
      "minLength": 1,
      "maxLength": 10000
    },
    "environment": {
      "type": "object",
      "required": [
        "url",
        "route",
        "title",
        "referrer",
        "timeOnPageMs",
        "userAgent",
        "browser",
        "os",
        "deviceType",
        "language",
        "timezone",
        "screen",
        "viewport",
        "devicePixelRatio",
        "colorScheme",
        "online",
        "libraryVersion"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "a string at least 1 character(s) long",
          "title": "minLength(1)",
          "minLength": 1
        },
        "route": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "referrer": {
          "type": "string"
        },
        "timeOnPageMs": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "userAgent": {
          "type": "string"
        },
        "browser": {
          "type": "string",
          "description": "a string at least 1 character(s) long",
          "title": "minLength(1)",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "description": "a string at least 1 character(s) long",
          "title": "minLength(1)",
          "minLength": 1
        },
        "deviceType": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile",
            "tablet",
            "unknown"
          ]
        },
        "language": {
          "type": "string",
          "description": "a string at least 1 character(s) long",
          "title": "minLength(1)",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "description": "a string at least 1 character(s) long",
          "title": "minLength(1)",
          "minLength": 1
        },
        "screen": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "height": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "height": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "devicePixelRatio": {
          "type": "number",
          "description": "a positive number",
          "title": "positive",
          "exclusiveMinimum": 0
        },
        "colorScheme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "online": {
          "type": "boolean"
        },
        "libraryVersion": {
          "type": "string",
          "description": "a string at least 1 character(s) long",
          "title": "minLength(1)",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reporter": {
      "type": "object",
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "x-maxSerializedBytes": 16384
    },
    "metadata": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "x-maxSerializedBytes": 16384
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "console",
        "network"
      ],
      "properties": {
        "console": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "message",
              "at"
            ],
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "message": {
                "type": "string",
                "description": "a string at most 2000 character(s) long",
                "title": "maxLength(2000)",
                "maxLength": 2000
              },
              "stack": {
                "type": "string",
                "description": "a string at most 4000 character(s) long",
                "title": "maxLength(4000)",
                "maxLength": 4000
              },
              "at": {
                "type": "string",
                "description": "a string matching the pattern ^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "description": "an array of at most 50 item(s)",
          "title": "maxItems(50)",
          "maxItems": 50
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "method",
              "url",
              "status",
              "at"
            ],
            "properties": {
              "method": {
                "type": "string",
                "description": "a string at least 1 character(s) long",
                "title": "minLength(1)",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "description": "a string at least 1 character(s) long",
                "title": "minLength(1)",
                "minLength": 1
              },
              "status": {
                "anyOf": [
                  {
                    "type": "number",
                    "enum": [
                      0
                    ]
                  },
                  {
                    "$ref": "#/$defs/Int",
                    "description": "a number between 100 and 599",
                    "title": "between(100, 599)",
                    "minimum": 100,
                    "maximum": 599
                  }
                ]
              },
              "at": {
                "type": "string",
                "description": "a string matching the pattern ^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "description": "an array of at most 50 item(s)",
          "title": "maxItems(50)",
          "maxItems": 50
        }
      },
      "additionalProperties": false
    },
    "screenshot": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "_tag",
            "width",
            "height",
            "size",
            "mimeType",
            "data"
          ],
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "Inline"
              ]
            },
            "width": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "height": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "size": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "mimeType": {
              "type": "string",
              "enum": [
                "image/png"
              ]
            },
            "uploadError": {
              "type": "string"
            },
            "data": {
              "type": "string",
              "description": "a string matching the pattern ^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "title": "minLength(1)",
              "minLength": 1,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "_tag",
            "width",
            "height",
            "size",
            "mimeType",
            "url",
            "key"
          ],
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "Uploaded"
              ]
            },
            "width": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "height": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "size": {
              "$ref": "#/$defs/Int",
              "description": "a positive number",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "mimeType": {
              "type": "string",
              "enum": [
                "image/png"
              ]
            },
            "uploadError": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "description": "a string matching the pattern ^https?:\\/\\/\\S+$",
              "pattern": "^https?:\\/\\/\\S+$",
              "format": "uri"
            },
            "key": {
              "type": "string",
              "description": "a string at least 1 character(s) long",
              "title": "minLength(1)",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$comment": "shortId is SL- followed by the final 20 UUID bits encoded as four Crockford base32 characters; reporter and metadata each have a 16384-byte serialized UTF-8 JSON limit (x-maxSerializedBytes). These constraints are enforced by shotlog at runtime."
}
