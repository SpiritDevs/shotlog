{
  "name": "shotlog",
  "version": "0.0.0",
  "description": "Support Logs with annotated Screenshots for React Host Apps.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "schema"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./schema.json": "./schema/support-log.v1.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "schema:generate": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "effect": "^3.22.0",
    "modern-screenshot": "^4.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "resend": "*",
    "@aws-sdk/client-sesv2": "*",
    "nodemailer": "*",
    "@uploadfile/core": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "resend": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "@uploadfile/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.30.0",
    "smtp-server": "^3.19.13"
  }
}
