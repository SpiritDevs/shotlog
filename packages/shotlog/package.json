{
  "name": "shotlog",
  "version": "0.0.0",
  "description": "In-app support reports for React with annotated screenshots, diagnostics, and email or webhook delivery.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./schema.json": "./schema/support-log.v1.json",
    "./ses": {
      "types": "./dist/ses.d.ts",
      "default": "./dist/ses.js"
    },
    "./smtp": {
      "types": "./dist/smtp.d.ts",
      "default": "./dist/smtp.js"
    },
    "./uploadfile": {
      "types": "./dist/uploadfile.d.ts",
      "default": "./dist/uploadfile.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "schema:generate": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "effect": "^3.22.0",
    "modern-screenshot": "^4.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@aws-sdk/client-sesv2": "*",
    "nodemailer": "*",
    "@uploadfile/core": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "@uploadfile/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@uploadfile/core": "0.2.0",
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smtp-server": "^3.19.13"
  },
  "homepage": "https://shotlog.dev",
  "keywords": [
    "support",
    "bug report",
    "screenshot",
    "annotation",
    "feedback",
    "react",
    "webhook",
    "email"
  ]
}
