{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "shotlog": ["./packages/shotlog/src/index.ts"],
      "shotlog/server": ["./packages/shotlog/src/server.ts"],
      "shotlog/node": ["./packages/shotlog/src/node.ts"],
      "shotlog/ses": ["./packages/shotlog/src/ses.ts"],
      "shotlog/smtp": ["./packages/shotlog/src/smtp.ts"]
    }
  },
  "exclude": ["**/*.test-d.ts"],
  "include": [
    "apps/playground",
    "packages/shotlog/src",
    "packages/shotlog/test",
    "packages/shotlog/scripts",
    "packages/shotlog/tsdown.config.ts",
    "scripts/*.ts",
    "vitest.config.ts"
  ]
}
