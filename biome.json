{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!**/api",
      "!!**/schema/*.json",
      "!!**/temp",
      "!!pnpm-lock.yaml",
      "!!assets"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": { "rules": { "preset": "recommended" } }
}
