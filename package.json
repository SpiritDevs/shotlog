{
  "name": "shotlog-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @shotlog/playground dev",
    "build": "pnpm --filter shotlog build",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit && pnpm --filter shotlog build && pnpm --filter next-example typecheck && tsc --noEmit -p e2e/tsconfig.json && pnpm --filter site typecheck",
    "lint": "biome check .",
    "test": "vitest run --typecheck",
    "api:check": "tsx scripts/api.ts",
    "api:update": "tsx scripts/api.ts --local",
    "check:package": "node scripts/check-package.mjs",
    "check:no-effect-dts": "node scripts/check-no-effect-dts.mjs",
    "schema:generate": "pnpm --filter shotlog schema:generate",
    "e2e": "pnpm --filter @shotlog/e2e exec playwright test",
    "e2e:chromium": "pnpm e2e --project=chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "2.31.1",
    "@microsoft/api-extractor": "7.59.2",
    "@types/node": "20.19.43",
    "tsdown": "0.21.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
